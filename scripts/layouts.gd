## Returns a copy mirrored horizontally and/or vertically (4 variants per template).
static func variant(lines: Array, flip_h: bool, flip_v: bool) -> Array[String]:
	var out: Array[String] = []
	for row: String in lines:
		out.append(row.reverse() if flip_h else row)
	if flip_v:
		out.reverse()
	return out
